# hack-kit environment — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# ── Primary (required) ──────────────────────────────────────────────
# Anthropic is the primary provider. All model calls go through lib/ai.py.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Optional fallback providers ─────────────────────────────────────
# lib/ai.py exposes provider-swap stubs. These are only needed if you
# wire up the OpenAI / Gemini fallbacks; leave blank otherwise.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Optional extras ─────────────────────────────────────────────────
# ElevenLabs — only if your demo needs text-to-speech / voice.
ELEVENLABS_API_KEY=

# ── App config (optional) ───────────────────────────────────────────
# Default model the wrapper uses when none is passed. One of:
#   claude-opus-4-8 (heavy) | claude-sonnet-4-6 (default) | claude-haiku-4-5 (fast)
# HACKKIT_MODEL=claude-sonnet-4-6
# Port the FastAPI app binds to (Makefile/dev default is 8000).
# PORT=8000
