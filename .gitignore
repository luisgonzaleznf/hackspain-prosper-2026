# Secrets
.env
.env.*
!.env.example

# A HAR capture carries the live dashboard session cookie in plain text.
*.har

# Private call material: recordings, per-call logs and the call ledger never
# belong in the public mirror. Patient data is the organisers' synthetic set,
# but the private cases themselves are not ours to publish.
*.wav
*.opus
logs/
docs/private-calls/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
*.sqlite3-shm
*.sqlite3-wal

# Node
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local agent session stubs (not part of the repo)
.claude/

# The subtree copies (leaderboard/, backend/) need the same protection as the root:
# a pattern containing a slash is anchored to this directory, so docs/private-calls/
# above does NOT cover leaderboard/docs/private-calls/.
**/docs/private-calls/

# ...but the agent's own prompt clips ARE code, not call recordings. *.wav above hides
# them, and without them the voice layer has no nudges to play. They are tracked in the
# private repo; keep them here too.
!**/app/voice/clips/*.wav
