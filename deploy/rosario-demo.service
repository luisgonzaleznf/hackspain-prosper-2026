[Unit]
Description=ROSARIO browser WebRTC call runner
After=network-online.target rosario.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hackspain-prosper-standalone/backend
EnvironmentFile=/home/ubuntu/hackspain-prosper-standalone/.env
Environment=CALLS_DIR=logs/phone-calls
Environment=AUDIO_DIR=logs/phone-audio
Environment=DATABASE_PATH=data/runtime.sqlite3
Environment='PIPECAT_ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:global.relay.metered.ca:80","username":"openrelayproject","credential":"openrelayproject"},{"urls":"turn:global.relay.metered.ca:443","username":"openrelayproject","credential":"openrelayproject"},{"urls":"turns:global.relay.metered.ca:443?transport=tcp","username":"openrelayproject","credential":"openrelayproject"}]'
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/home/ubuntu/.local/bin/uv run --project . python -m app.demo.bot --host 127.0.0.1 --port 7862 --transport webrtc
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
