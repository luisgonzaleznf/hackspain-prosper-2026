{
  "name": "rosario-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "recordings:import": "python3 tools/import-recordings.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm lint:design",
    "lint:design": "oxlint -c oxlint.config.ts --ignore-pattern \"tools/design-lint/fixtures/**\" . && stylelint \"**/*.css\" --ip \"tools/design-lint/fixtures/**\"",
    "brand": "python3 -m http.server 4173 --bind 0.0.0.0",
    "serve": "pnpm build && pnpm preview",
    "test:design-lint": "node tools/design-lint/test.mjs",
    "test": "node --experimental-strip-types --test src/lib/__tests__/*.test.ts && python3 -m unittest discover -s tools -p 'test_*.py'"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@number-flow/react": "0.6.2",
    "@phosphor-icons/react": "2.1.10",
    "@pipecat-ai/client-js": "1.13.1",
    "@pipecat-ai/small-webrtc-transport": "1.10.8",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "orb-ui": "^0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.83.0",
    "stylelint": "17.15.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
