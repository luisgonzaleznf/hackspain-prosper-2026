# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Standalone SQLite clinic ──
DATABASE_PATH=data/clinic.sqlite3
PUBLIC_WEBSOCKET_URL=wss://rosario.fyi/integrations/twilio/ws

# ── Serving ──
# Voice layer: codex | gptlive | none
VOICE=codex
PORT=7860
# Twilio points its incoming-call webhook at https://HOST/twiml.
# The response connects to PUBLIC_WEBSOCKET_URL above.

# ── Optional email for human demos (never enabled for scored calls) ──
APPOINTMENT_EMAILS_ENABLED=0
RESEND_API_KEY=
# Use a sender on your verified Resend domain, e.g. Rosario <citas@rosario.fyi>.
RESEND_FROM_EMAIL=
# Customer records stay under the ignored logs directory.
CUSTOMER_DB_PATH=logs/demo/customers.sqlite3

# ── Call artifacts are owned by this package ──
CALLS_DIR=logs/calls
AUDIO_DIR=logs/audio
# Also keep the caller leg alone, for `make replay-call`
# RECORD_CALLER_AUDIO=1

# ── Model keys ──
# Codex/GPT-Live signs in through the local ChatGPT stack, so it needs no key here.
# OPENAI_API_KEY is for the eval caller and the gptlive voice layer.
OPENAI_API_KEY=

# ── Voice-layer knobs (defaults shown; leave unset to use them) ──
# GPTLIVE_MODEL=gpt-live-1
# GPTLIVE_BRAIN_MODEL=gpt-5.6-luna
# GPTLIVE_VOICE=marin

# ── Local evals only ──
# Pin relative dates to the case's reference time (never set for a real Prosper dial)
# EVAL_MODE=1
# EVAL_CALLER_MODEL=
