# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Prosper clinic API (required for live reads + submit) ──
PLATFORM_API_KEY=
PLATFORM_API_BASE_URL=https://hackspain.getprosperapp.com

# ── Serving ──
# Voice layer: codex | gptlive | none
VOICE=codex
PORT=7860
# Account identifier for the real Twilio inbound webhook (keep its value in root .env).
TWILIO_ACCOUNT_SID=
# Stable tunnel hostname, so the dashboard address survives a reconnect
# NGROK_DOMAIN=

# ── Call artifacts are owned by this package ──
CALLS_DIR=logs/calls
AUDIO_DIR=logs/audio
# Also keep the caller leg alone, for `make replay-call`
# RECORD_CALLER_AUDIO=1

# ── Model keys ──
# Codex/GPT-Live signs in through the local ChatGPT stack, so it needs no key here.
# OPENAI_API_KEY is for the eval caller and the gptlive voice layer.
OPENAI_API_KEY=

# ── Voice-layer knobs (defaults shown; leave unset to use them) ──
# GPTLIVE_MODEL=gpt-live-1
# GPTLIVE_BRAIN_MODEL=gpt-5.6-luna
# GPTLIVE_VOICE=marin

# ── Local evals only ──
# Pin relative dates to the case's reference time (never set for a real Prosper dial)
# EVAL_MODE=1
# EVAL_CALLER_MODEL=
